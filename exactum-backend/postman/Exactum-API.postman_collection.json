          "name": "Registrar usuario (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Usuario Prueba\",\n  \"email\": \"{{email}}\",\n  \"password\": \"secreto1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('email', 'user' + Date.now() + '@mail.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Usuario creado (status 201)\", () => pm.response.to.have.status(201));",
                  "const u = pm.response.json();",
                  "pm.test('No devuelve la contraseña', () => pm.expect(u).to.not.have.property('password'));",
                  "pm.collectionVariables.set('userId', u.id);"
                ]
              }
            }
          ]
        },
